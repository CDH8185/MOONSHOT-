# Copy this file to .env (same folder) and fill in values. .env is git ignored.
# Create a Coinbase Developer Platform (CDP) API key with the ECDSA signature
# algorithm. Grant VIEW and TRADE only. Never grant TRANSFER: the bot refuses
# to start with a key that holds the transfer permission.

# Option 1: key name and private key.
# COINBASE_API_KEY=organizations/<org_id>/apiKeys/<key_id>
# COINBASE_API_SECRET="-----BEGIN EC PRIVATE KEY-----\n...\n-----END EC PRIVATE KEY-----\n"
COINBASE_API_KEY=
COINBASE_API_SECRET=

# Option 2: path to the downloaded CDP key JSON file (use instead of option 1).
COINBASE_API_KEY_FILE=

# shadow (default) logs theoretical trades only. live is not enabled until Phase 3.
COF_TRADING_MODE=shadow

# REST client behaviour.
COF_REQUEST_TIMEOUT_S=10
COF_MAX_RETRIES=5
COF_BACKOFF_BASE_S=1.0
COF_BACKOFF_CAP_S=30
# Client side ceiling. Coinbase allows 10,000 requests per hour per key; 2 per second is 7,200.
COF_REST_MAX_RPS=2

# Asset universe filters.
# Bases excluded as Tier 1 (the bot does not hold these). Stablecoins are always excluded.
COF_EXCLUDED_BASES=BTC,ETH
# Liquidity floor in USD of 24 hour quote volume. 0 disables the floor.
COF_MIN_QUOTE_VOLUME_24H=100000
# Optional ceiling to keep the universe to smaller assets. Blank disables it.
COF_MAX_QUOTE_VOLUME_24H=

# Phase 2: live market data, news and signals (python -m cof_bot stream).
# Reconnect when no WebSocket message arrives for this long (heartbeats come every second).
COF_WS_STALE_AFTER_S=15
COF_WS_BACKOFF_CAP_S=60
# Order books kept for the hot list. Coinbase refused more than 30 per connection (measured 2026-09-27).
COF_L2_MAX_PRODUCTS=25
COF_NEWS_POLL_S=120
COF_NEWS_MAX_AGE_S=21600
COF_EVAL_INTERVAL_S=5
# Volume surge: last 5 minutes against the prior 60 minutes.
COF_VOLUME_WINDOW_S=300
COF_VOLUME_BASELINE_S=3600
COF_VOLUME_RATIO_MIN=2.0
COF_MIN_WINDOW_USD=5000
COF_MIN_BUY_SHARE=0.55
# Sentiment spike.
COF_SENTIMENT_WINDOW_S=3600
COF_MENTION_BASELINE_S=86400
COF_MIN_MENTIONS=1
COF_SPIKE_MULTIPLE=2.0
COF_MIN_MEAN_SENTIMENT=0.3
COF_NEGATIVE_VETO=-0.3
COF_MAX_LAG_S=1800
COF_SIGNAL_COOLDOWN_S=900
COF_HOT_VOLUME_RATIO=1.5
